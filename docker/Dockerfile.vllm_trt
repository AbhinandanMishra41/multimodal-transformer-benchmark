# Linux GPU image for the parts that don't run on Windows: vLLM and TensorRT.
#
#   docker build -f docker/Dockerfile.vllm_trt -t vlm-bench .
#   docker run --gpus all --rm -v $(pwd)/results:/workspace/results vlm-bench
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/src

RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# vllm pins its own torch build, so install it first and let it pick torch.
# Specs are quoted - unquoted, `pkg>=1.0` is a shell redirect.
RUN pip3 install --no-cache-dir --upgrade pip \
    && pip3 install --no-cache-dir "vllm>=0.6" \
    && pip3 install --no-cache-dir "onnx>=1.15" "onnxruntime-gpu>=1.17" "tensorrt>=10" numpy matplotlib pytest

# the tensorrt wheel ships libnvinfer inside site-packages; ORT's TensorRT EP needs it on the loader path
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/tensorrt_libs:${LD_LIBRARY_PATH}

COPY . /workspace

CMD ["sh", "-c", "pytest -q && python3 -m benchmark.runner --profile compact && python3 -m benchmark.vllm_run"]
